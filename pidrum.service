[Unit]
Description=PiDrum - batterie d'apprentissage
After=sound.target

[Service]
User=__USER__
WorkingDirectory=/home/__USER__/pidrum
Environment=SDL_VIDEODRIVER=kmsdrm
Environment=SDL_AUDIODRIVER=alsa
Environment=PYTHONUNBUFFERED=1
# Sortie audio : ne pas modifier ici, utiliser une surcharge locale (voir README)
#   /etc/systemd/system/pidrum.service.d/audio.conf
ExecStart=/usr/bin/python3 /home/__USER__/pidrum/pidrum.py
SupplementaryGroups=video render input audio
# Priorite CPU elevee : le thread kit doit reprendre la main sans attendre
Nice=-10
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
